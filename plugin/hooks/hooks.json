{
  "description": "Runs an armed magi handoff once the turn has ended, and refuses input in a session that has moved",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/magi\" hook stop",
            "timeout": 200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/magi\" hook prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
