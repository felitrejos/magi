{
  "description": "Runs an armed magi handoff once the turn has ended, refuses input in a session that has moved, and tells a session handed back what changed",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "magi hook stop",
            "timeout": 200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "magi hook prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "magi hook start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
