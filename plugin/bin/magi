#!/bin/sh
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
version=${MAGI_VERSION:-$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json")}
[ -n "$version" ] || { echo "magi can't read its version from $root/.claude-plugin/plugin.json" >&2; exit 1; }
bin=$HOME/.magi/bin

install() {
  case $(uname -s)/$(uname -m) in
    Darwin/arm64) target=darwin_arm64 ;;
    Darwin/x86_64) target=darwin_amd64 ;;
    Linux/x86_64) target=linux_amd64 ;;
    Linux/aarch64 | Linux/arm64) target=linux_arm64 ;;
    *) echo "magi has no build for $(uname -s) $(uname -m)" >&2; exit 1 ;;
  esac
  url=${MAGI_RELEASE_URL:-https://github.com/felitrejos/magi/releases/download/v$version}
  archive=magi_$target.tar.gz
  mkdir -p "$bin"
  find "$bin" -maxdepth 1 -name '.download.*' -mmin +10 -exec rm -rf {} +
  work=$(mktemp -d "$bin/.download.XXXXXX")
  trap 'rm -rf "$work"' EXIT
  for file in "$archive" checksums.txt; do
    curl -fsSL --connect-timeout 10 --max-time 120 --proto '=https,file' --proto-redir '=https' -o "$work/$file" "$url/$file"
  done
  want=$(awk -v f="$archive" '$2 == f { print $1 }' "$work/checksums.txt")
  if command -v sha256sum >/dev/null; then got=$(sha256sum "$work/$archive"); else got=$(shasum -a 256 "$work/$archive"); fi
  if [ -z "$want" ] || [ "$want" != "${got%% *}" ]; then
    echo "magi $version's download doesn't match its checksum, so it wasn't installed" >&2
    exit 1
  fi
  tar -xzf "$work/$archive" -C "$work" magi
  mv -f "$work/magi" "$bin/magi-$version"
  ln -s "magi-$version" "$work/link"
  mv -f "$work/link" "$bin/magi"
}

if [ ! -x "$bin/magi-$version" ]; then (install); fi
exec "$bin/magi-$version" "$@"
